# Files excluded from the Vercel upload.
#
# Vercel CLI caps uploaded source at 100 MB on Hobby and 1 GB on Pro. This
# project was over the Hobby cap, almost entirely because build output and
# local artefacts were being shipped to the build container.

# Build output. `collectstatic` regenerates this on every build, so shipping
# the previous run only inflates the function bundle.
staticfiles/

# Local database. Never deployed: production uses Postgres via DATABASE_URL,
# and a sqlite file in the bundle would be a stale, confusing fallback.
db.sqlite3
db.sqlite3-journal

# Secrets. Vercel supplies these as environment variables.
.env
.env.*
!.env.example

# Local tooling caches and editor noise.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store
*.log
.vercel/

# Mirror scratch output from local verification runs.
tmp/

# Superseded captures, kept for reference locally only.
_backup_templates/
