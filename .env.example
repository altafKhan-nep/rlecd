# Environment contract for this project.
# Copy to .env for local development, or set these as Vercel project
# environment variables for deployment. Never commit real values.
#
#   VERCEL: Project Settings -> Environment Variables
#   Mark every secret as "Sensitive" so it is not readable in build logs.

# ---------------------------------------------------------------------------
# REQUIRED -- the app will refuse to start without these.
# config() raises on a missing key, which is deliberate: a build that
# half-configures itself is worse than one that fails loudly.
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Comma-separated list of recipients for new-lead notifications.
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------

# Managed Postgres is REQUIRED in deployment. A serverless filesystem is
# ephemeral, so db.sqlite3 cannot persist content or leads between invocations.
# Any provider works; Neon integrates with Vercel in two clicks.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABDB?sslmode=require
# Leave unset locally to fall back to db.sqlite3.
DATABASE_URL=

# ---------------------------------------------------------------------------
# HOSTS, URLS AND CSRF
# ---------------------------------------------------------------------------

# Comma-separated. Must include the deployment hostname, or every request
# returns 400.
ALLOWED_HOSTS=homeimp.quantumcoresoftware.com,www.homeimp.quantumcoresoftware.com

# Canonical origin used for canonical links, Open Graph and the sitemap.
SITE_URL=https://homeimp.quantumcoresoftware.com

# Origins allowed to POST. REQUIRED on any new hostname: without it, GETs work
# and every form POST fails 403, so the site looks healthy but nothing saves.
CSRF_TRUSTED_ORIGINS=https://homeimp.quantumcoresoftware.com

# ---------------------------------------------------------------------------
# BEHAVIOUR FLAGS
# ---------------------------------------------------------------------------

# Must be False on any deployed build. settings.py raises on startup if DEBUG
# is True while VERCEL_ENV is 'preview' or 'production'.
DEBUG=False

# Set to "true" to let the Vercel build step run `migrate`. Keep it off for
# preview deployments so a branch preview cannot migrate the production
# database. Run migrations explicitly for the first deploy instead.
RUN_MIGRATIONS_ON_BUILD=false

# Set True only for the primary domain. Preload/includeSubDomains are
# per-registrable-domain commitments and must stay False on a shared platform
# hostname such as *.vercel.app.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Override only if the platform's TLS terminator does not set
# X-Forwarded-Proto.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Stored page sections are compiled by the template engine, so content editors
# can use {% static %}/{% url %}. That grants them template-level power; set
# False to render stored HTML as literal text instead.
CONTENT_ALLOW_TEMPLATES=true

# Seconds a single SMTP send may block. A serverless request has a hard
# wall-clock limit, so an unbounded connect would hold the invocation open.
EMAIL_TIMEOUT=10

# Browser cache lifetime for static assets, in seconds.
WHITENOISE_MAX_AGE=3600
